# --- YouTube Downloader Configuration ---

# The host port where the Nginx web server will be exposed (default: 80)
PORT=80

# Telegram Bot Token (optional). If set, the bot will start automatically.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of origins allowed by CORS (optional).
# e.g., CORS_ORIGINS=http://yourdomain.com,https://yourdomain.com
CORS_ORIGINS=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=yt_downloader

# JWT Authentication Configuration
JWT_SECRET=yoursupersecretjwtkeyhere
